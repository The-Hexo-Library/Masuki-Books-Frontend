# Frontend API base URL.
# Local dev example: http://localhost:8081
# Production example: https://masuki-books-backend.onrender.com
VITE_API_URL="http://localhost:8081"

# Toggle optional Supabase catalog fallback reads.
VITE_ENABLE_SUPABASE_CATALOG=false

# Supabase public config (only needed when VITE_ENABLE_SUPABASE_CATALOG=true).
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_SUPABASE_BOOKS_TABLE=books
VITE_RAZORPAY_KEY_ID=""
